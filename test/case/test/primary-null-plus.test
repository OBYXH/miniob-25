-- sort SELECT * FROM t_null WHERE 1 = NULL;
-- sort SELECT * FROM t_null WHERE NULL <> 1;
-- sort SELECT * FROM t_null WHERE 1 <> NULL;
-- sort SELECT * FROM t_null WHERE NULL > 1;
-- sort SELECT * FROM t_null WHERE 1 > NULL;

