-- sort SELECT * FROM t_null WHERE 1 IS NULL;
-- sort SELECT * FROM t_null WHERE 1 IS NOT NULL;
-- sort SELECT * FROM t_null WHERE NULL IS NULL;
-- sort SELECT * FROM t_null WHERE NULL IS NOT NULL;
