-- echo INITIALIZATION
CREATE TABLE t_alias(id INT, name CHAR);
INSERT INTO t_alias VALUES(1, 'a');
INSERT INTO t_alias VALUES(2, 'b');
INSERT INTO t_alias VALUES(3, 'c');

CREATE TABLE t_alias2(id INT, value CHAR);
INSERT INTO t_alias2 VALUES(1, 'x');
INSERT INTO t_alias2 VALUES(3, 'y');

-- echo 2. BASIC ALIAS SYNTAX
-- sort SELECT id AS alias_id, name AS alias_name FROM t_alias;
-- sort SELECT id id_implicit, name name_implicit FROM t_alias;
-- sort SELECT id AS a, name n FROM t_alias;

-- echo 3. ALIASING EXPRESSIONS AND CONSTANTS
-- sort SELECT id, id + 100 AS id_plus_100 FROM t_alias;
-- sort SELECT id, 'const' AS constant_string, 999 AS constant_num FROM t_alias;

-- echo 4. ALIAS USAGE IN CLAUSES
-- sort SELECT id AS my_id, name AS my_name FROM t_alias;
SELECT id AS my_id FROM t_alias WHERE my_id > 1;
-- sort SELECT id AS my_id FROM t_alias WHERE id > 1;

-- echo 5. ALIASING WITH JOINS
-- sort SELECT t_alias.id AS id1, t_alias.name, t_alias2.id AS id2, t_alias2.value FROM t_alias, t_alias2 WHERE t_alias.id = t_alias2.id;