-- echo 1. initialization
CREATE TABLE t_alias_1 (id INT, name CHAR(10), score INT);
CREATE TABLE t_alias_2 (id INT, city CHAR(10));
INSERT INTO t_alias_1 VALUES (1, 'a', 100);
INSERT INTO t_alias_1 VALUES (2, 'b', 90);
INSERT INTO t_alias_2 VALUES (1, 'city_x');
INSERT INTO t_alias_2 VALUES (2, 'city_y');

-- echo 2. basic column alias (Explicit AS)
-- sort SELECT id AS user_id, name AS user_name FROM t_alias_1;
-- sort SELECT id user_id, name user_name FROM t_alias_1;

-- echo 3. basic table alias (Qualified Columns)
-- sort SELECT t1.id, t1.name FROM t_alias_1 AS t1;

-- echo 4. implicit table alias (Qualified Columns)
-- sort SELECT t1.id, t1.name FROM t_alias_1 t1;

-- echo 5. qualified column without table alias
-- sort SELECT t_alias_1.id, t_alias_1.name FROM t_alias_1;

-- echo 6. multi-table with qualified columns
-- sort SELECT t1.id, t1.name, t2.city FROM t_alias_1 AS t1, t_alias_2 AS t2 WHERE t1.id = t2.id;

-- echo 7. multi-table with ambiguous columns (NEW)
-- sort SELECT t1.id, t2.id FROM t_alias_1 t1, t_alias_2 t2 WHERE t1.id = t2.id;

-- echo 8. mixed qualified and explicit alias
-- sort SELECT t1.id AS user_id, t1.name, t2.city AS user_city FROM t_alias_1 t1, t_alias_2 t2 WHERE t1.id = t2.id;

-- echo 9. error - duplicate table alias
SELECT * FROM t_alias_1 AS t, t_alias_2 AS t;

-- echo 10. success - duplicate table alias in subquery
-- sort SELECT t.id FROM t_alias_1 t WHERE t.id IN (SELECT t.id FROM t_alias_2 t WHERE t.city = 'city_x');
-- sort SELECT * FROM t_alias_1 t1 WHERE id in (SELECT t2.id FROM t_alias_2 t2 WHERE t2.city >= t1.name);

-- echo 11. error - column alias in where
SELECT id AS user_id FROM t_alias_1 WHERE user_id = 1;

-- echo 12. control test for echo 11
-- sort SELECT id AS user_id FROM t_alias_1 WHERE id = 1;

-- echo 13. mixed qualification headers (COMPREHENSIVE)
-- sort SELECT t1.id, name FROM t_alias_1 t1;
-- sort SELECT id, t1.name FROM t_alias_1 t1;
-- sort SELECT t_alias_1.id, name FROM t_alias_1;
-- sort SELECT t1.* FROM t_alias_1 t1;
-- sort SELECT t_alias_1.* FROM t_alias_1;

-- echo 14. ambiguous column errors (COMPREHENSIVE)
SELECT id FROM t_alias_1 t1, t_alias_2 t2 WHERE t1.id = t2.id;
SELECT t1.id, id FROM t_alias_1 t1, t_alias_2 t2 WHERE t1.id = t2.id;

-- echo 15. star alias error
select * as alias from t_alias_1 t1;