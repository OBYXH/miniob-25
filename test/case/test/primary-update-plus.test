-- echo UPDATE TEST REVISED

-- echo =================================================================
-- echo TEST 1: 基础数据类型与WHERE子句测试
-- echo =================================================================
create table t_update_basic(id int, hire_date date, dept char(15), salary float);
insert into t_update_basic values(1, '2023-01-15', 'HR', 50000.0);
insert into t_update_basic values(2, '2022-05-20', 'ENG', 75000.0);
insert into t_update_basic values(3, '2023-01-15', 'ENG', 80000.0);
insert into t_update_basic values(4, '2021-11-30', 'SALE', 65000.0);
insert into t_update_basic values(5, '2023-08-01', 'SALE', 68000.0);
-- sort select * from t_update_basic;

-- echo [WHERE] 1.1: 更新单行 (通过ID)
update t_update_basic set salary=82000.50 where id=3;
-- sort select * from t_update_basic;

-- echo [WHERE] 1.2: 更新多行 (通过非键值)
update t_update_basic set dept='SALES_DEPT' where dept='SALE';
-- sort select * from t_update_basic;

-- echo [WHERE] 1.3: 更新多行 (通过DATE类型)
update t_update_basic set hire_date='2023-02-01' where hire_date='2023-01-15';
-- sort select * from t_update_basic;

-- echo [WHERE] 1.4: 更新多行 (复合条件 AND)
update t_update_basic set salary=80000.0 where dept='ENG' and id=2;
-- sort select * from t_update_basic;

-- echo [WHERE] 1.5: 条件不匹配 (0行受影响)
update t_update_basic set salary=100000.0 where id=99;
-- sort select * from t_update_basic;

-- echo [WHERE] 1.6: 无WHERE子句 (更新全表)
update t_update_basic set dept='COMPANY_WIDE';
-- sort select * from t_update_basic;

-- echo =================================================================
-- echo TEST 2: 边界与错误情况
-- echo =================================================================
create table t_update_empty(id int, value char);

-- echo [EDGE] 2.1: 更新一个空表 (0行受影响)
update t_update_empty set value='no_data';
-- sort select * from t_update_empty;

-- echo [EDGE] 2.2: 尝试更新不存在的表 (预期失败)
update non_existent_table set value=1;

-- echo [EDGE] 2.3: 尝试更新不存在的列 (预期失败)
update t_update_basic set non_existent_col='error' where id=1;