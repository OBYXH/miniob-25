-- echo 6. group by on a column that is all NULLs
create table t_all_null (id int, val int);
insert into t_all_null values(NULL, 10);
insert into t_all_null values(NULL, 20);
insert into t_all_null values(NULL, 30);
-- sort select id, sum(val) from t_all_null group by id;  

