-- echo 9. group by composite key with nulls (NEW)
create table t_group_by_multi (val int, group1 char, group2 char);
insert into t_group_by_multi values(10, 'a', 'x');
insert into t_group_by_multi values(20, 'a', 'y');
insert into t_group_by_multi values(30, 'a', NULL);
insert into t_group_by_multi values(40, 'b', 'x');
insert into t_group_by_multi values(50, NULL, 'x');
insert into t_group_by_multi values(60, NULL, 'y');
insert into t_group_by_multi values(70, NULL, 'y');
insert into t_group_by_multi values(80, NULL, NULL);
insert into t_group_by_multi values(90, 'a', NULL);
-- sort select group1, group2, count(*), sum(val) from t_group_by_multi group by group1, group2;

