-- echo 1. initialization
CREATE TABLE t_group_by_null (id int, score int, name char);
INSERT INTO t_group_by_null VALUES(1, 10, 'a');
INSERT INTO t_group_by_null VALUES(2, 20, 'a');
INSERT INTO t_group_by_null VALUES(3, NULL, 'a');
INSERT INTO t_group_by_null VALUES(4, 30, 'b');
INSERT INTO t_group_by_null VALUES(5, NULL, 'b');
INSERT INTO t_group_by_null VALUES(6, 40, NULL);
INSERT INTO t_group_by_null VALUES(7, 50, NULL);
INSERT INTO t_group_by_null VALUES(8, NULL, NULL);

