-- echo 1. initialization
CREATE TABLE t_knn (id INT, vec VECTOR(4));

-- echo 2. insert vector data
INSERT INTO t_knn VALUES(1, STRING_TO_VECTOR('[1, 1, 1, 2]'));
INSERT INTO t_knn VALUES(2, STRING_TO_VECTOR('[1, 1, 1, 3]'));
INSERT INTO t_knn VALUES(3, STRING_TO_VECTOR('[1, 1, 9, 9]'));
INSERT INTO t_knn VALUES(4, STRING_TO_VECTOR('[1, 1, 1, 1]'));
INSERT INTO t_knn VALUES(5, STRING_TO_VECTOR('[5, 1, 1, 1]'));
INSERT INTO t_knn VALUES(6, STRING_TO_VECTOR('[0, 0, 0, 0]'));
INSERT INTO t_knn VALUES(7, STRING_TO_VECTOR('[1, 2, 1, 2]'));
INSERT INTO t_knn VALUES(8, STRING_TO_VECTOR('[1, 0, 1, 0]'));
INSERT INTO t_knn VALUES(9, STRING_TO_VECTOR('[9, 9, 9, 9]'));
INSERT INTO t_knn VALUES(10, STRING_TO_VECTOR('[2, 2, 2, 2]'));

