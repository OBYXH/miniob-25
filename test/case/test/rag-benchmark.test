CREATE TABLE rag_documents(content TEXT, metadata TEXT, embedding VECTOR(3));
INSERT INTO rag_documents VALUES('aaaa', 'bbbb', STRING_TO_VECTOR('[2,3,4]'));
INSERT INTO rag_documents VALUES('aaa''', '''bb''c"ccc"bbb''', STRING_TO_VECTOR('[1,2,3]'));
INSERT INTO rag_documents VALUES('aaa', '''cccc''', STRING_TO_VECTOR('[2,3,4]'));
INSERT INTO rag_documents VALUES('aaa', '\\\\''cccc''', STRING_TO_VECTOR('[2,3,4]'));
CREATE VECTOR INDEX rag_embedding_index ON rag_documents(embedding);
SELECT * FROM rag_documents ORDER BY Distance(embedding, '[1,2,3]', 'COSINE') LIMIT 2;