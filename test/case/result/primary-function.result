1. INITIALIZATION
CREATE TABLE function_table (id INT, name CHAR(20), score FLOAT, u_date DATE);
SUCCESS

INSERT INTO function_table VALUES (1, 'abc', 10.1, '2024-12-05');
SUCCESS
INSERT INTO function_table VALUES (2, 'hello world', 12.8, '2025-01-09');
SUCCESS
INSERT INTO function_table VALUES (3, 'test', 15.5, '2024-03-31');
SUCCESS
INSERT INTO function_table VALUES (4, '', -3.7, '2024-02-02');
SUCCESS
INSERT INTO function_table VALUES (5, NULL, NULL, NULL);
SUCCESS

2. TEST LENGTH FUNCTION
SELECT id, LENGTH(name) FROM function_table;
1 | 3
2 | 11
3 | 4
4 | 1
5 | NULL
ID | LENGTH(NAME)
SELECT id, name FROM function_table WHERE LENGTH(name) > 4;
2 | HELLO WORLD
ID | NAME

3. TEST LENGTH TYPE ERRORS
SELECT LENGTH(id) FROM function_table;
FAILURE
SELECT LENGTH(score) FROM function_table;
FAILURE
SELECT LENGTH(u_date) FROM function_table;
FAILURE

4. TEST ROUND FUNCTION
SELECT id, score, ROUND(score) FROM function_table;
1 | 10.1 | 10
2 | 12.8 | 13
3 | 15.5 | 16
4 | -3.7 | -4
5 | NULL | NULL
ID | SCORE | ROUND(SCORE)
SELECT id, score FROM function_table WHERE ROUND(score) < 10;
4 | -3.7
ID | SCORE

5. TEST ROUND TYPE ERRORS
SELECT ROUND(id) FROM function_table;
FAILURE
SELECT ROUND(name) FROM function_table;
FAILURE
SELECT ROUND(u_date) FROM function_table;
FAILURE

6. TEST DATE_FORMAT FUNCTION
SELECT id, DATE_FORMAT(u_date, '%Y-%m-%d') FROM function_table;
1 | 2024-12-05
2 | 2025-01-09
3 | 2024-03-31
4 | 2024-02-02
5 | NULL
ID | DATE_FORMAT(U_DATE, '%Y-%M-%D')
SELECT id, DATE_FORMAT(u_date, '%D %M %y') FROM function_table;
1 | 5th December 24
2 | 9th January 25
3 | 31st March 24
4 | 2nd February 24
5 | NULL
ID | DATE_FORMAT(U_DATE, '%D %M %Y')

7. TEST DATE_FORMAT ILLEGAL/UNSUPPORTED FORMATS
SELECT id, DATE_FORMAT(u_date, 'Date: %Y%n %z %M') FROM function_table WHERE id=1;
1 | Date: 2024n z December
ID | DATE_FORMAT(U_DATE, 'DATE: %Y%N %Z %M')

8. TEST DATE_FORMAT IN WHERE
SELECT id, name FROM function_table WHERE DATE_FORMAT(u_date, '%Y') = '2024';
1 | ABC
3 | TEST
4 |
ID | NAME

9. TEST DATE_FORMAT TYPE ERRORS
SELECT DATE_FORMAT(id, '%Y') FROM function_table;
FAILURE
SELECT DATE_FORMAT(name, '%Y') FROM function_table;
FAILURE
SELECT DATE_FORMAT(score, '%Y') FROM function_table;
FAILURE

10. COMBINED FUNCTION SELECT (AS IN EXAMPLE)
SELECT id, LENGTH(name), ROUND(score), DATE_FORMAT(u_date, '%D,%M,%Y') FROM function_table;
1 | 3 | 10 | 5th,December,2024
2 | 11 | 13 | 9th,January,2025
3 | 4 | 16 | 31st,March,2024
4 | 0 | -4 | 2nd,February,2024
5 | NULL | NULL | NULL
ID | LENGTH(NAME) | ROUND(SCORE) | DATE_FORMAT(U_DATE, '%D,%M,%Y')