INITIALIZATION
CREATE TABLE T_NULL(ID INT NOT NULL, NUM INT NULL, PRICE FLOAT NULL, BIRTHDAY DATE NULL, NAME CHAR(10) NULL);
SUCCESS
CREATE TABLE T_NULL2(ID INT NOT NULL, NUM INT NULL, NOTE CHAR(10) NULL);
SUCCESS
CREATE INDEX IDX_NUM ON T_NULL(NUM);
SUCCESS

1. BASIC INSERTS
INSERT INTO T_NULL VALUES (1, 10, 9.9, '2021-01-01', 'A');
SUCCESS
INSERT INTO T_NULL VALUES (2, NULL, 8.8, '2020-02-02', 'B');
SUCCESS
INSERT INTO T_NULL VALUES (3, 30, NULL, NULL, 'C');
SUCCESS
INSERT INTO T_NULL VALUES (4, 40, 4.4, '2019-03-03', NULL);
SUCCESS
INSERT INTO T_NULL VALUES (5, NULL, NULL, NULL, NULL);
SUCCESS
INSERT INTO T_NULL VALUES (6, 0, 0.0, '2000-01-01', 'ZERO');
SUCCESS
INSERT INTO T_NULL VALUES (7, 5, 1.5, NULL, 'NEG');
SUCCESS

1.1 INSERTS INTO SECOND TABLE FOR CROSS-TABLE TESTS
INSERT INTO T_NULL2 VALUES (1, 10, 'MATCH');
SUCCESS
INSERT INTO T_NULL2 VALUES (2, NULL, 'NULLNUM');
SUCCESS
INSERT INTO T_NULL2 VALUES (3, 50, 'NOMATCH');
SUCCESS

