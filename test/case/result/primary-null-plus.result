5. EQUALITY/INEQUALITY WITH NULL
SELECT * FROM t_null WHERE num = NULL;
ID | NUM | PRICE | BIRTHDAY | NAME
SELECT * FROM t_null WHERE NULL = num;
ID | NUM | PRICE | BIRTHDAY | NAME
SELECT * FROM t_null WHERE num <> NULL;
ID | NUM | PRICE | BIRTHDAY | NAME
SELECT * FROM t_null WHERE NULL <> num;
ID | NUM | PRICE | BIRTHDAY | NAME

6. COMPARISONS WHERE EXPRESSION MAY YIELD NULL
SELECT * FROM t_null WHERE num + 1 > 10;       
SELECT * FROM t_null WHERE num * price > 0;    
SELECT * FROM t_null WHERE price + 1 IS NULL;  
SELECT * FROM t_null WHERE (num - 10) IS NULL;

7. BOOLEAN LOGIC WITH NULL
SELECT * FROM t_null WHERE num > 10 AND num IS NULL;
ID | NUM | PRICE | BIRTHDAY | NAME
SELECT * FROM t_null WHERE num > 0 AND price IS NULL;
3 | 30 | NULL | NULL | c
ID | NUM | PRICE | BIRTHDAY | NAME

8. CROSS-TABLE COMPARISONS (NULL IN JOIN CONDITIONS)
SELECT t_null.id,t_null.num,t_null2.id,t_null2.num FROM t_null,t_null2 WHERE t_null.num = t_null2.num;
1 | 10 | 1 | 10
ID | NUM | ID | NUM

9. UPDATES INVOLVING NULL
UPDATE t_null SET num = NULL WHERE id = 1;
SUCCESS
UPDATE t_null SET price = 5.5 WHERE price IS NULL;
SUCCESS
UPDATE t_null SET name = NULL WHERE id = 6;
SUCCESS
UPDATE t_null SET num = 100 WHERE num IS NOT NULL;
SUCCESS
UPDATE t_null SET price = 9.9 WHERE price IS NOT NULL;
SUCCESS

9.1 SELECT AFTER UPDATES
SELECT * FROM t_null;
1 | NULL | 9.9 | 2021-01-01 | A
2 | NULL | 9.9 | 2020-02-02 | B
3 | 100 | 9.9 | NULL | C
4 | 100 | 9.9 | 2019-03-03 | NULL
5 | NULL | 9.9 | NULL | NULL
6 | 100 | 9.9 | 2000-01-01 | NULL
7 | 100 | 9.9 | NULL | NEG
ID | NUM | PRICE | BIRTHDAY | NAME

10. DELETES INVOLVING NULL
DELETE FROM t_null WHERE birthday IS NULL;
SUCCESS
SELECT after delete
SELECT * FROM t_null;
1 | NULL | 9.9 | 2021-01-01 | A
2 | NULL | 9.9 | 2020-02-02 | B
4 | 100 | 9.9 | 2019-03-03 | NULL
6 | 100 | 9.9 | 2000-01-01 | NULL
ID | NUM | PRICE | BIRTHDAY | NAME

11. COMBINATION OF PREDICATES WITH NULL IN WHERE
SELECT * FROM t_null WHERE num IS NULL AND price IS NULL;
ID | NUM | PRICE | BIRTHDAY | NAME
SELECT * FROM t_null WHERE num IS NULL AND name IS NULL;
ID | NUM | PRICE | BIRTHDAY | NAME
UPDATE t_null SET birthday = null WHERE id = 4
SUCCESS
SELECT * FROM t_null WHERE birthday IS NULL AND name IS NULL;
4 | 100 | 9.9 | NULL | NULL
ID | NUM | PRICE | BIRTHDAY | NAME

12. INSERTING ROWS THAT ARE ALL NULL EXCEPT NOT NULL id
INSERT INTO t_null VALUES (8, NULL, NULL, NULL, NULL);
SUCCESS

13. INSERTING INTO NOT-NULL COLUMN (SHOULD ERROR)
INSERT INTO t_null VALUES (NULL, 100, 10.0, '2022-01-01', 'z');
FAILURE

18. CROSS-TABLE WHERE SECOND TABLE HAS NULL NUM
SELECT t_null.id, t_null.num, t_null2.id, t_null2.num FROM t_null, t_null2 WHERE t_null.num = t_null2.num;
ID | NUM | ID | NUM