14. CROSS-TABLE WHERE SECOND TABLE HAS NULL NUM
SELECT T_NULL.ID, T_NULL.NUM, T_NULL2.ID, T_NULL2.NUM FROM T_NULL, T_NULL2 WHERE T_NULL.NUM = T_NULL2.NUM;
T_NULL.ID | T_NULL.NUM | T_NULL2.ID | T_NULL2.NUM

