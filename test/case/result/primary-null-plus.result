5. EQUALITY/INEQUALITY WITH NULL
SELECT * FROM T_NULL WHERE NUM = NULL;
ID | NUM | PRICE | BIRTHDAY | NAME
SELECT * FROM T_NULL WHERE NULL = NUM;
ID | NUM | PRICE | BIRTHDAY | NAME
SELECT * FROM T_NULL WHERE NUM <> NULL;
ID | NUM | PRICE | BIRTHDAY | NAME
SELECT * FROM T_NULL WHERE NULL <> NUM;
ID | NUM | PRICE | BIRTHDAY | NAME

6. COMPARISONS WHERE EXPRESSION MAY YIELD NULL
SELECT * FROM T_NULL WHERE NUM + 1 > 10;
SELECT * FROM T_NULL WHERE NUM * PRICE > 0;
SELECT * FROM T_NULL WHERE PRICE + 1 IS NULL;
SELECT * FROM T_NULL WHERE (NUM - 10) IS NULL;

7. BOOLEAN LOGIC WITH NULL
SELECT * FROM T_NULL WHERE NUM > 10 AND NUM IS NULL;
ID | NUM | PRICE | BIRTHDAY | NAME
SELECT * FROM T_NULL WHERE NUM > 0 AND PRICE IS NULL;
3 | 30 | NULL | NULL | C
ID | NUM | PRICE | BIRTHDAY | NAME

8. CROSS-TABLE COMPARISONS (NULL IN JOIN CONDITIONS)
SELECT T_NULL.ID,T_NULL.NUM,T_NULL2.ID,T_NULL2.NUM FROM T_NULL,T_NULL2 WHERE T_NULL.NUM = T_NULL2.NUM;
1 | 10 | 1 | 10
T_NULL.ID | T_NULL.NUM | T_NULL2.ID | T_NULL2.NUM

9. UPDATES INVOLVING NULL
UPDATE T_NULL SET NUM = NULL WHERE ID = 1;
SUCCESS
UPDATE T_NULL SET PRICE = 5.5 WHERE PRICE IS NULL; TODO: 查询时索引无法识别NULL，因为NULL != NULL
SUCCESS
UPDATE T_NULL SET NAME = NULL WHERE ID = 6;
SUCCESS
UPDATE T_NULL SET NUM = 100 WHERE NUM IS NOT NULL;
SUCCESS
UPDATE T_NULL SET PRICE = 9.9 WHERE PRICE IS NOT NULL; TODO: 查询时索引无法识别NULL，因为NULL != NULL
SUCCESS

