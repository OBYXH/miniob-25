INITIALIZATION
CREATE TABLE t_null(id int not null, num int null, price float null, birthday date null, name char(10) null);
SUCCESS
CREATE TABLE t_null2(id int not null, num int null, note char(10) null);
SUCCESS
CREATE INDEX idx_num on t_null(num);
SUCCESS

1. BASIC INSERTS
INSERT INTO t_null VALUES (1, 10, 9.9, '2021-01-01', 'a');
SUCCESS
INSERT INTO t_null VALUES (2, NULL, 8.8, '2020-02-02', 'b');
SUCCESS
INSERT INTO t_null VALUES (3, 30, NULL, NULL, 'c');
SUCCESS
INSERT INTO t_null VALUES (4, 40, 4.4, '2019-03-03', NULL);
SUCCESS
INSERT INTO t_null VALUES (5, NULL, NULL, NULL, NULL);
SUCCESS
INSERT INTO t_null VALUES (6, 0, 0.0, '2000-01-01', 'zero');
SUCCESS
INSERT INTO t_null VALUES (7, 5, 1.5, NULL, 'neg');
SUCCESS

1.1 INSERTS INTO SECOND TABLE FOR CROSS-TABLE TESTS
INSERT INTO t_null2 VALUES (1, 10, 'match');
SUCCESS
INSERT INTO t_null2 VALUES (2, NULL, 'nullnum');
SUCCESS
INSERT INTO t_null2 VALUES (3, 50, 'nomatch');
SUCCESS

2. SELECT WHOLE TABLE
SELECT * FROM t_null;
1 | 10 | 9.9 | 2021-01-01 | A
2 | NULL | 8.8 | 2020-02-02 | B
3 | 30 | NULL | NULL | C
4 | 40 | 4.4 | 2019-03-03 | NULL
5 | NULL | NULL | NULL | NULL
6 | 0 | 0 | 2000-01-01 | ZERO
7 | 5 | 1.5 | NULL | NEG
ID | NUM | PRICE | BIRTHDAY | NAME

3. CONSTANT VS NULL COMPARISONS
-- These are logical checks; expected behavior: IS NULL/IS NOT NULL evaluated correctly
SELECT * FROM t_null where 1 is null;
ID | NUM | PRICE | BIRTHDAY | NAME
SELECT * FROM t_null where 1 is not null;
1 | 10 | 9.9 | 2021-01-01 | A
2 | NULL | 8.8 | 2020-02-02 | B
3 | 30 | NULL | NULL | C
4 | 40 | 4.4 | 2019-03-03 | NULL
5 | NULL | NULL | NULL | NULL
6 | 0 | 0 | 2000-01-01 | ZERO
7 | 5 | 1.5 | NULL | NEG
ID | NUM | PRICE | BIRTHDAY | NAME
SELECT * FROM t_null WHERE NULL IS NULL;
1 | 10 | 9.9 | 2021-01-01 | A
2 | NULL | 8.8 | 2020-02-02 | B
3 | 30 | NULL | NULL | C
4 | 40 | 4.4 | 2019-03-03 | NULL
5 | NULL | NULL | NULL | NULL
6 | 0 | 0 | 2000-01-01 | ZERO
7 | 5 | 1.5 | NULL | NEG
ID | NUM | PRICE | BIRTHDAY | NAME
SELECT * FROM t_null WHERE NULL IS NOT NULL;
ID | NUM | PRICE | BIRTHDAY | NAME
SELECT * FROM t_null WHERE NULL = 1;
ID | NUM | PRICE | BIRTHDAY | NAME
SELECT * FROM t_null WHERE 1 = NULL;
ID | NUM | PRICE | BIRTHDAY | NAME
SELECT * FROM t_null WHERE NULL <> 1;
ID | NUM | PRICE | BIRTHDAY | NAME
SELECT * FROM t_null WHERE 1 <> NULL;
ID | NUM | PRICE | BIRTHDAY | NAME
SELECT * FROM t_null WHERE NULL > 1;
ID | NUM | PRICE | BIRTHDAY | NAME
SELECT * FROM t_null WHERE 1 > NULL;
ID | NUM | PRICE | BIRTHDAY | NAME

