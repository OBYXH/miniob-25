INITIALIZATION
CREATE TABLE UNIQUE_TABLE(ID INT, COL1 INT, COL2 INT);
SUCCESS
CREATE TABLE UNIQUE_TABLE2(ID1 INT, ID2 INT, COL1 INT, COL2 INT);
SUCCESS
CREATE TABLE UNIQUE_TABLE3(ID INT, COL1 INT, COL2 INT);
SUCCESS
CREATE TABLE UNIQUE_TABLE4(ID INT, COL1 INT, COL2 INT);
SUCCESS
INSERT INTO UNIQUE_TABLE VALUES (1,1,1);
SUCCESS
INSERT INTO UNIQUE_TABLE2 VALUES (1,1,1,1);
SUCCESS

1. BASIC UNIQUE TEST
CREATE UNIQUE INDEX INDEX_ID ON UNIQUE_TABLE(ID);
SUCCESS
INSERT INTO UNIQUE_TABLE VALUES (2,1,1);
SUCCESS
CREATE UNIQUE INDEX INDEX_ID ON UNIQUE_TABLE(ID);
FAILURE
INSERT INTO UNIQUE_TABLE VALUES (3,2,1);
SUCCESS
INSERT INTO UNIQUE_TABLE VALUES (1,2,1);
FAILURE
CREATE UNIQUE INDEX INDEX_ID2 ON UNIQUE_TABLE2(ID1, ID2);
SUCCESS
INSERT INTO UNIQUE_TABLE2 VALUES (1,1,2,1);
FAILURE
INSERT INTO UNIQUE_TABLE2 VALUES (1,2,1,1);
SUCCESS
INSERT INTO UNIQUE_TABLE2 VALUES (1,2,2,1);
FAILURE
INSERT INTO UNIQUE_TABLE2 VALUES (1,3,4,2);
SUCCESS
INSERT INTO UNIQUE_TABLE2 VALUES (2,1,1,1);
SUCCESS

2. SELECT AFTER BASIC TESTS
SELECT * FROM UNIQUE_TABLE;
1 | 1 | 1
2 | 1 | 1
3 | 2 | 1
ID | COL1 | COL2
SELECT * FROM UNIQUE_TABLE2;
1 | 1 | 1 | 1
1 | 2 | 1 | 1
1 | 3 | 4 | 2
2 | 1 | 1 | 1
ID1 | ID2 | COL1 | COL2

3. UPDATE TEST
UPDATE UNIQUE_TABLE2 SET ID1=1,ID2=4 WHERE ID2=2;
SUCCESS
SELECT * FROM UNIQUE_TABLE2;
1 | 1 | 1 | 1
1 | 3 | 4 | 2
1 | 4 | 1 | 1
2 | 1 | 1 | 1
ID1 | ID2 | COL1 | COL2
UPDATE UNIQUE_TABLE2 SET ID1=1,ID2=3 WHERE ID2=2;
SUCCESS
SELECT * FROM UNIQUE_TABLE2;
1 | 1 | 1 | 1
1 | 3 | 4 | 2
1 | 4 | 1 | 1
2 | 1 | 1 | 1
ID1 | ID2 | COL1 | COL2
UPDATE UNIQUE_TABLE2 SET ID1=1,ID2=3 WHERE ID2=4;
FAILURE
SELECT * FROM UNIQUE_TABLE2;
1 | 1 | 1 | 1
1 | 3 | 4 | 2
1 | 4 | 1 | 1
2 | 1 | 1 | 1
ID1 | ID2 | COL1 | COL2

4. MULTIPLE UNIQUE INDEXES TEST
CREATE UNIQUE INDEX INDEX_COL1_COL2 ON UNIQUE_TABLE3(COL1, COL2);
SUCCESS
INSERT INTO UNIQUE_TABLE3 VALUES (1, 10, 10);
SUCCESS
INSERT INTO UNIQUE_TABLE3 VALUES (4, 1, 1);
SUCCESS
INSERT INTO UNIQUE_TABLE3 VALUES (4, 10, 10);
FAILURE
SELECT * FROM UNIQUE_TABLE3;
1 | 10 | 10
4 | 1 | 1
ID | COL1 | COL2

5. NULL VALUE TEST (UNIQUE CONSTRAINT ALLOWS MULTIPLE NULLS)
CREATE UNIQUE INDEX INDEX_COL1_COL2 ON UNIQUE_TABLE4(COL1, COL2);
SUCCESS
INSERT INTO UNIQUE_TABLE4 VALUES (1, 100, 100);
SUCCESS
INSERT INTO UNIQUE_TABLE4 VALUES (2, 200, NULL);
SUCCESS
INSERT INTO UNIQUE_TABLE4 VALUES (3, NULL, 10);
SUCCESS
INSERT INTO UNIQUE_TABLE4 VALUES (4, NULL, 20);
SUCCESS
INSERT INTO UNIQUE_TABLE4 VALUES (5, NULL, NULL);
SUCCESS
INSERT INTO UNIQUE_TABLE4 VALUES (6, 200, NULL);
FAILURE
SELECT * FROM UNIQUE_TABLE4;
1 | 100 | 100
2 | 200 | NULL
3 | NULL | 10
4 | NULL | 20
5 | NULL | NULL
ID | COL1 | COL2

6. DROP INDEX TEST
DROP INDEX INDEX_ID ON UNIQUE_TABLE;
SUCCESS
INSERT INTO UNIQUE_TABLE VALUES (1, 400, 400);
SUCCESS
SHOW INDEX FROM UNIQUE_TABLE;
TABLE | INDEX_NAME | COLUMN_NAME | SEQ_IN_INDEX | NON_UNIQUE
SELECT * FROM UNIQUE_TABLE;
1 | 1 | 1
1 | 400 | 400
2 | 1 | 1
3 | 2 | 1
ID | COL1 | COL2
