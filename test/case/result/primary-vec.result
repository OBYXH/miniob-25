INITIALIZATION
CREATE TABLE items (id INT, embedding VECTOR(3));
SUCCESS
CREATE TABLE test_ops (id INT, v1 VECTOR(3), v2 VECTOR(3));
SUCCESS

1. BASIC INSERTS
INSERT INTO items VALUES (1, '[1.0, 2.0, 3.0]');
SUCCESS
INSERT INTO items VALUES (2, [4.0, 5.0, 6.0]);
SUCCESS
INSERT INTO items VALUES (3, '[7.5, 8.5, 9.5]');
SUCCESS
INSERT INTO items VALUES (4, '[-1.0, 0.0, 1.0]');
SUCCESS
INSERT INTO items VALUES (5, [0,0,0]);
SUCCESS

INSERT INTO test_ops VALUES(1,  '[1 ,2, 3]' , '[4,  5  , 6]');
SUCCESS
INSERT INTO test_ops VALUES(2,  '[10,   0,  -10]' , '[-5,5,0]'  );
SUCCESS

SELECT * FROM items;
1 | [1,2,3]
2 | [4,5,6]
3 | [7.5,8.5,9.5]
4 | [-1,0,1]
5 | [0,0,0]
ID | EMBEDDING
SELECT * FROM test_ops;
1 | [1,2,3] | [4,5,6]
2 | [10,0,-10] | [-5,5,0]
ID | V1 | V2

2. ARITHMETIC OPERATIONS
SELECT embedding + [1,1,1] FROM items;
[0,1,2]
[1,1,1]
[2,3,4]
[5,6,7]
[8.5,9.5,10.5]
EMBEDDING + [1,1,1]
SELECT embedding - '[0.5,0.5,0.5]' FROM items;
[-0.5,-0.5,-0.5]
[-1.5,-0.5,0.5]
[0.5,1.5,2.5]
[3.5,4.5,5.5]
[7,8,9]
EMBEDDING - '[0.5,0.5,0.5]'
SELECT v1 * v2 FROM test_ops;
[-50,0,-0]
[4,10,18]
V1 * V2
SELECT (v1 + v2) - v1 FROM test_ops;
(V1 + V2) - V1
[-5,5,0]
[4,5,6]

3. COMPARISON OPERATIONS
SELECT * FROM items WHERE embedding = '[1.0, 2.0, 3.0]';
1 | [1,2,3]
ID | EMBEDDING
SELECT * FROM items WHERE embedding > '[4.0, 0.0, 0.0]';
2 | [4,5,6]
3 | [7.5,8.5,9.5]
ID | EMBEDDING
SELECT * FROM items WHERE embedding < '[1.0, 0.0, 0.0]';
4 | [-1,0,1]
5 | [0,0,0]
ID | EMBEDDING
SELECT * FROM items WHERE embedding <> '[0,0,0]';
1 | [1,2,3]
2 | [4,5,6]
3 | [7.5,8.5,9.5]
4 | [-1,0,1]
ID | EMBEDDING

4. DISTANCE FUNCTIONS
SELECT id, L2_DISTANCE(embedding, '[0,0,0]') FROM items;
1 | 3.74
2 | 8.77
3 | 14.79
4 | 1.41
5 | 0
ID | L2_DISTANCE(EMBEDDING, '[0,0,0]')
SELECT id, COSINE_DISTANCE(embedding, '[1,2,3]') FROM items;
1 | 0
2 | 0.03
3 | 0.04
4 | 0.62
5 | NULL
ID | COSINE_DISTANCE(EMBEDDING, '[1,2,3]')
SELECT id, INNER_PRODUCT(embedding, '[1,0,1]') FROM items;
1 | 4
2 | 10
3 | 17
4 | 0
5 | 0
ID | INNER_PRODUCT(EMBEDDING, '[1,0,1]')

SELECT id, L2_DISTANCE(v1, v2), COSINE_DISTANCE(v1, v2), INNER_PRODUCT(v1, v2) FROM test_ops;
1 | 5.2 | 0.03 | 32
2 | 18.71 | 1.5 | -50
ID | L2_DISTANCE(V1, V2) | COSINE_DISTANCE(V1, V2) | INNER_PRODUCT(V1, V2)

5. COMPREHENSIVE QUERIES
CREATE TABLE test_search (id INT, c1 VECTOR(3));
SUCCESS
INSERT INTO test_search VALUES(1, '[1,1,1]');
SUCCESS
INSERT INTO test_search VALUES(2, '[1,2,3]');
SUCCESS
INSERT INTO test_search VALUES(3, '[9,9,9]');
SUCCESS
SELECT c1, c1 + [0.5,0.5,0.5] FROM test_search WHERE L2_DISTANCE(c1, '[0,0,0]') > 5;
[9, 9, 9] | [9.5, 9.5, 9.5]
C1 | C1 + [0.5, 0.5, 0.5]

6. ERROR HANDLING AND EDGE CASES
INSERT INTO items VALUES (6, '[1,2,3,4]');
FAILURE
SELECT embedding + [1,1] FROM items;
embedding + [1,1]
SELECT L2_DISTANCE(embedding, '[1,2]') FROM items;
L2_DISTANCE(embedding, '[1,2]')
SELECT COSINE_DISTANCE(embedding, '[0,0,0]') FROM items WHERE id = 5;
COSINE_DISTANCE(EMBEDDING, '[0,0,0]')
NULL
