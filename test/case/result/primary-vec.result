1 | [1.00000e+00,2.00000e+00,3.00000e+00] | [4.00000e+00,5.00000e+00,6.00000e+00]
2 | [1.00000e+01,0.00000e+00,-1.00000e+01] | [-5.00000e+00,5.00000e+00,0.00000e+00]
ID | V1 | V2

2. ARITHMETIC OPERATIONS
SELECT embedding + STRING_TO_VECTOR('[1,1,1]') FROM items;
embedding + STRING_TO_VECTOR('[1,1,1]')
[2.00000e+00,3.00000e+00,4.00000e+00]
[5.00000e+00,6.00000e+00,7.00000e+00]
[8.50000e+00,9.50000e+00,1.05000e+01]
[0.00000e+00,1.00000e+00,2.00000e+00]
[1.00000e+00,1.00000e+00,1.00000e+00]
SELECT embedding - STRING_TO_VECTOR('[0.5,0.5,0.5]') FROM items;
embedding - STRING_TO_VECTOR('[0.5,0.5,0.5]')
[5.00000e-01,1.50000e+00,2.50000e+00]
[3.50000e+00,4.50000e+00,5.50000e+00]
[7.00000e+00,8.00000e+00,9.00000e+00]
[-1.50000e+00,-5.00000e-01,5.00000e-01]
[-5.00000e-01,-5.00000e-01,-5.00000e-01]
SELECT v1 * v2 FROM test_ops;
v1 * v2
[4.00000e+00,1.00000e+01,1.80000e+01]
[-5.00000e+01,0.00000e+00,-0.00000e+00]
SELECT (v1 + v2) - v1 FROM test_ops;
(v1 + v2) - v1
[4.00000e+00,5.00000e+00,6.00000e+00]
[-5.00000e+00,5.00000e+00,0.00000e+00]

3. COMPARISON OPERATIONS
SELECT * FROM items WHERE embedding = STRING_TO_VECTOR('[1.0, 2.0, 3.0]');
1 | [1.00000e+00,2.00000e+00,3.00000e+00]
ID | EMBEDDING
SELECT * FROM items WHERE embedding > STRING_TO_VECTOR('[4.0, 0.0, 0.0]');
2 | [4.00000e+00,5.00000e+00,6.00000e+00]
3 | [7.50000e+00,8.50000e+00,9.50000e+00]
ID | EMBEDDING
SELECT * FROM items WHERE embedding < STRING_TO_VECTOR('[1.0, 0.0, 0.0]');
4 | [-1.00000e+00,0.00000e+00,1.00000e+00]
5 | [0.00000e+00,0.00000e+00,0.00000e+00]
ID | EMBEDDING
SELECT * FROM items WHERE embedding <> STRING_TO_VECTOR('[0,0,0]');
1 | [1.00000e+00,2.00000e+00,3.00000e+00]
2 | [4.00000e+00,5.00000e+00,6.00000e+00]
3 | [7.50000e+00,8.50000e+00,9.50000e+00]
4 | [-1.00000e+00,0.00000e+00,1.00000e+00]
ID | EMBEDDING

4. DISTANCE FUNCTIONS
