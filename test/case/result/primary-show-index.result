1. SHOW EMPTY INDEX
SHOW INDEX FROM INDEX_TABLE_1;
TABLE | INDEX_NAME | COLUMN_NAME | SEQ_IN_INDEX | NON_UNIQUE

2. SHOW AN INDEX
CREATE INDEX INDEX_ID_1 ON INDEX_TABLE_1(ID);
SUCCESS
SHOW INDEX FROM INDEX_TABLE_1;
TABLE | INDEX_NAME | COLUMN_NAME | SEQ_IN_INDEX | NON_UNIQUE
INDEX_TABLE_1 | INDEX_ID_1 | ID | 1 | 1

3. SHOW INDEXES
CREATE INDEX INDEX_ID_2 ON INDEX_TABLE_1(ID);
SUCCESS
CREATE INDEX INDEX_ID_3 ON INDEX_TABLE_1(AGE);
SUCCESS
SHOW INDEX FROM INDEX_TABLE_1;
TABLE | INDEX_NAME | COLUMN_NAME | SEQ_IN_INDEX | NON_UNIQUE
INDEX_TABLE_1 | INDEX_ID_1 | ID | 1 | 1 
INDEX_TABLE_1 | INDEX_ID_2 | ID | 1 | 1
INDEX_TABLE_1 | INDEX_ID_3 | AGE | 1 | 1
