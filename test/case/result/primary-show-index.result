SUCCESS
INSERT INTO INDEX_TABLE_1 VALUES (3,3);
SUCCESS
INSERT INTO INDEX_TABLE_1 VALUES (1,2);
SUCCESS
INSERT INTO INDEX_TABLE_1 VALUES (1,3);
