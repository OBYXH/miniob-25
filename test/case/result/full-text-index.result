1. INITIALIZATION
CREATE TABLE articles(id INT, content TEXT);
SUCCESS
INSERT INTO articles VALUES (1, 'A database is an organized collection of data, generally stored and accessed electronically from a computer system.');
SUCCESS
INSERT INTO articles VALUES (2, 'Computer science is the study of computation, automation, and information.');
SUCCESS

2. CREATE FULLTEXT INDEX
ALTER TABLE articles ADD FULLTEXT INDEX idx_content (content) WITH PARSER jieba;
SUCCESS
SHOW INDEX FROM articles;
TABLE | INDEX_NAME | COLUMN_NAME | SEQ_IN_INDEX | NON_UNIQUE
articles | idx_content | content | 1 | 1

3. INSERT AFTER INDEX CREATION
INSERT INTO articles VALUES (3, 'SQL is a standard language for database management. A database query can be complex.');
SUCCESS
INSERT INTO articles VALUES (4, 'A search engine is a software system designed to carry out web searches. The search results are generally presented in a line of results.');
SUCCESS
INSERT INTO articles VALUES (5, 'This article is about database search. Database search is a key feature.');
SUCCESS

4. BASIC SEARCH AND RANKING TEST
SELECT id, MATCH(content) AGAINST('database') AS score FROM articles WHERE MATCH(content) AGAINST('database') > 0;
5 | 1.10
3 | 0.60
1 | 0.47
ID | SCORE
SELECT id, MATCH(content) AGAINST('search') AS score FROM articles WHERE MATCH(content) AGAINST('search') > 0;
4 | 1.10
5 | 0.60
ID | SCORE

5. MULTI-TERM CHINESE SEARCH
SELECT id, MATCH(content) AGAINST('数据库 查询') AS score FROM articles WHERE MATCH(content) AGAINST('数据库 查询') > 0;
5 | 1.70
3 | 1.46
1 | 0.47
ID | SCORE

6. NO MATCH TEST
SELECT id, MATCH(content) AGAINST('nonexistentword') AS score FROM articles WHERE MATCH(content) AGAINST('nonexistentword') > 0;
ID | SCORE

7. UPDATE TEST
UPDATE articles SET content = 'Computer science is the study of computation, automation, and information. It involves database theory.' WHERE id = 2;
SUCCESS
SELECT id, MATCH(content) AGAINST('database') AS score FROM articles WHERE MATCH(content) AGAINST('database') > 0;
5 | 0.92
3 | 0.51
2 | 0.41
1 | 0.41
ID | SCORE

8. DELETE TEST
DELETE FROM articles WHERE id = 5;
SUCCESS
SELECT id, MATCH(content) AGAINST('database') AS score FROM articles WHERE MATCH(content) AGAINST('database') > 0;
3 | 0.51
2 | 0.41
1 | 0.41
ID | SCORE

9. TOKENIZE FUNCTION TEST
SELECT TOKENIZE('数据库系统的核心是查询引擎', 'jieba') as text_tokens;
["数据库", "系统", "核心", "查询", "引擎"]
TEXT_TOKENS

10. DROP INDEX TEST
DROP INDEX idx_content ON articles;
SUCCESS
SELECT id, content, MATCH(content) AGAINST('database') AS score FROM articles;
FAILURE
SHOW INDEX FROM articles;
TABLE | INDEX_NAME | COLUMN_NAME | SEQ_IN_INDEX | NON_UNIQUE